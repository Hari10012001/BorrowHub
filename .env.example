# BorrowHub Environment Configuration Template
# Copy this file to .env and adjust variables for your local development environment.
#
# SECURITY REQUIREMENTS:
# 1. Do NOT commit the actual .env file to version control (.env is excluded by .gitignore).
# 2. Never place real production credentials or actual passwords in this example file.
# 3. Generate unique, cryptographically strong values for all local placeholders below.

# Database Configuration (MySQL 8.0 with InnoDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=borrowhub_db
DB_USERNAME=borrowhub_user
DB_PASSWORD=replace-with-your-local-mysql-password

# Spring Boot Profile & Server Configuration
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# JWT Security Configuration
# Generate a cryptographically secure random secret of at least 32 bytes (256 bits).
# Example command to generate: openssl rand -hex 32
JWT_SECRET=generate-a-unique-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# File Uploads Directory
FILE_UPLOAD_DIR=./uploads

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Local Initial Seed Account Passwords
# Used by DataInitializer ONLY when initializing an empty database with no existing users.
# You MUST replace each placeholder with a distinct, strong password for local testing.
# Never reuse passwords across roles or environments.
BORROWHUB_SEED_ADMIN_PASSWORD=replace-with-a-unique-admin-password
BORROWHUB_SEED_FACULTY_PASSWORD=replace-with-a-unique-faculty-password
BORROWHUB_SEED_STAFF_PASSWORD=replace-with-a-unique-staff-password
BORROWHUB_SEED_STUDENT_PASSWORD=replace-with-a-unique-student-password
