# BorrowHub Frontend Environment Configuration
# Default for local development (uses Vite dev server proxy to http://localhost:8080)
VITE_API_BASE_URL=/api

# For DockHosting production deployment:
# Set this to your deployed DockHosting backend URL + /api
# Example:
# VITE_API_BASE_URL=https://borrowhub-backend.dockhosting.dev/api
